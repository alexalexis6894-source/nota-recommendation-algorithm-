# nota.staytech.ru: приложение НОТА. Файл собирает growth-lab/scripts/publish_nota_site.py.
Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json
AddType application/json .json
RewriteEngine On
# www ведёт на основной адрес. С http на https переводит сам хостинг (настройка сайта в панели).
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://nota.staytech.ru%{REQUEST_URI} [R=301,L]
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
